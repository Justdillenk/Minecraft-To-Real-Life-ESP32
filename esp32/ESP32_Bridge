#include <WiFi.h>
#include <WebServer.h>

const char* ssid = "wifi name";
const char* password = "wifi_password";

const char* yeelightIP = "yeelight IP";
const int yeelightPort = yeelight port;
WiFiClient yeelightClient;

WebServer server(80);


float health = 20.0;
float prevHealth = 20.0;
int hunger = 20;

#define BUZZER_PIN 13


void sendYeelight(String method, String params) {
  WiFiClient client;
  if (client.connect(yeelightIP, yeelightPort)) {
    String cmd = "{\"id\":1,\"method\":\"" + method + "\",\"params\":[" + params + "]}\r\n";
    client.print(cmd);
    delay(100);
    client.stop();
  } else {
    Serial.println("Yeelight connection failed");
  }
}

void setHealthColor(float h) {
  if (h > 13) {
    sendYeelight("set_rgb", "65280,\"smooth\",500");       // green
  } else if (h > 6) {
    sendYeelight("set_rgb", "16776960,\"smooth\",500");    // yellow
  } else {
    sendYeelight("set_rgb", "16711680,\"smooth\",500");    // red
  }
}

void flashDamage(float h) {
  sendYeelight("set_rgb", "16777215,\"smooth\",0");        // white flash
  delay(200);
  setHealthColor(h);                                        // back to health color
}

void beepDamage() {
  digitalWrite(BUZZER_PIN, HIGH);
  delay(100);
  digitalWrite(BUZZER_PIN, LOW);
}

void beepCritical() {
  for (int i = 0; i < 3; i++) {
    digitalWrite(BUZZER_PIN, HIGH);
    delay(100);
    digitalWrite(BUZZER_PIN, LOW);
    delay(100);
  }
}

void handleUpdate() {
  if (server.hasArg("health") && server.hasArg("hunger")) {
    prevHealth = health;
    health = server.arg("health").toFloat();
    hunger = server.arg("hunger").toInt();

    Serial.printf("Health: %.1f/20  |  Hunger: %d/20\n", health, hunger);

    if (health < prevHealth) {
      Serial.println("Damage taken!");
      flashDamage(health);
      if (health <= 6) {
        Serial.println("Critical health!");
        beepCritical();
      } else {
        beepDamage();
      }
    } else {
      setHealthColor(health);
    }

    server.send(200, "text/plain", "OK");
  } else {
    server.send(400, "text/plain", "Missing args");
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  WiFi.begin(ssid, password);
  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nConnected! IP: " + WiFi.localIP().toString());

  server.on("/update", handleUpdate);
  server.begin();
}

void loop() {
  server.handleClient();
}
